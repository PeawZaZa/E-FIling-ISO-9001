# ---- ฐานข้อมูล ----
DATABASE_URL="postgresql://efiling:efiling@localhost:5432/efiling?schema=public"

# ---- Policy Pack ----
# srsab    = ตาม SRS_A+B.md ของกลุ่ม A (ค่าตั้งต้น)
# proposal = ตามแบบเสนอหัวข้อ SE02 และบทที่ 1
POLICY_VARIANT=srsab

# ---- เซิร์ฟเวอร์ ----
PORT=4000
JWT_SECRET=เปลี่ยนค่านี้ก่อนใช้งานจริง
JWT_EXPIRES_IN=8h

# ---- ที่จัดเก็บไฟล์หลักฐาน ----
UPLOAD_DIR=./uploads

# ---- ใช้เมื่อ POLICY_VARIANT=proposal เท่านั้น ----
# ที่อยู่ของส่วนต่อประสานระบบกลุ่ม A (อ่านอย่างเดียว ทิศทางเดียว)
GROUP_A_BASE_URL=http://localhost:4100
