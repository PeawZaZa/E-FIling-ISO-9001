DATABASE_URL="postgresql://efiling:CHANGE_ME@127.0.0.1:5432/efiling?schema=public&connect_timeout=3&socket_timeout=3"
API_PORT=3001
# Optional absolute private storage directory; defaults to efiling/.local/document-storage
# DOCUMENT_STORAGE_DIR="F:/private/efiling-documents"
# Optional private evidence storage and per-file limit (1–128 MB, default 10)
# RECORD_STORAGE_DIR="F:/private/efiling-records"
# RECORD_MAX_FILE_MB=10
# Comma-separated allowed content MIME types; defaults to PDF, JPG, PNG and Office files
# RECORD_ALLOWED_MIME_TYPES="application/pdf,image/jpeg,image/png"
